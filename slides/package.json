{
  "name": "loop-engineering-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build --out dist",
    "export:png": "slidev export --format png --output ../exports/png",
    "export:pdf": "slidev export --output ../exports/loop-engineering.pdf",
    "preview": "python3 -m http.server 4173 --directory dist"
  },
  "dependencies": {
    "@slidev/cli": "52.15.2",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.49.0"
  }
}
